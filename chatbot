<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chatbot Burger Blenger</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Custom CSS untuk tampilan lebih baik */
        body {
            font-family: sans-serif;
            background-color: #f3f4f6; /* Tailwind: gray-100 */
        }

        .chat-container {
            width: 90%;
            max-width: 600px;
            margin: 20px auto;
            border-radius: 0.5rem; /* Tailwind: rounded-lg */
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); /* Tailwind: shadow-md */
        }

        .chat-header {
            background-color: #3b82f6; /* Tailwind: blue-500 */
            color: white;
            padding: 1rem;
            text-align: center;
        }

        .chat-messages {
            padding: 1rem;
            height: 400px;
            overflow-y: scroll;
            background-color: white; /* Tailwind: bg-white */
        }

        .message {
            margin-bottom: 0.75rem; /* Tailwind: mb-3 */
            padding: 0.75rem; /* Tailwind: p-3 */
            border-radius: 0.5rem; /* Tailwind: rounded-lg */
            word-wrap: break-word; /* Allow long words to wrap */
        }

        .user-message {
            background-color: #dbeafe; /* Tailwind: blue-100 */
            align-self: flex-end;
            text-align: right;
        }

        .bot-message {
            background-color: #e2e8f0; /* Tailwind: gray-200 */
            align-self: flex-start;
            text-align: left;
        }

        .input-area {
            display: flex;
            padding: 1rem;
            background-color: white;
            border-top: 1px solid #e2e8f0; /* Tailwind: gray-200 */
        }

        .input-field {
            flex-grow: 1;
            padding: 0.75rem; /* Tailwind: p-3 */
            border: 1px solid #cbd5e1; /* Tailwind: gray-300 */
            border-radius: 0.375rem; /* Tailwind: rounded-md */
        }

        .send-button {
            padding: 0.75rem 1rem; /* Tailwind: p-3 px-4 */
            background-color: #3b82f6; /* Tailwind: blue-500 */
            color: white;
            border: none;
            border-radius: 0.375rem; /* Tailwind: rounded-md */
            cursor: pointer;
            margin-left: 0.5rem; /* Tailwind: ml-2 */
        }

        .send-button:hover {
            background-color: #2563eb; /* Tailwind: blue-700 */
        }
    </style>
</head>

<body>
    <div class="chat-container">
        <div class="chat-header">
            <h2 class="text-xl font-semibold">Ngab Blenger Chatbot</h2>
        </div>
        <div class="chat-messages" id="chatMessages">
            <!-- Pesan awal dari bot -->
            <div class="message bot-message">
                Halo! Selamat datang di Ngab Blenger. Ada yang bisa saya bantu hari ini? 😊
            </div>
        </div>
        <div class="input-area">
            <input type="text" id="userInput" class="input-field" placeholder="Ketik pesan Anda...">
            <button onclick="sendMessage()" class="send-button">Kirim</button>
        </div>
    </div>

    <script>
        const chatMessages = document.getElementById('chatMessages');
        const userInput = document.getElementById('userInput');

        // Knowledge Base
        const knowledgeBase = {
            "lokasi": "Kami berlokasi di Semarang (Pusat) dan juga melayani pemesanan online.",
            "jam buka": "Kami buka setiap hari mulai pukul 16.00 hingga 23.00.",
            "menu": "Menu kami meliputi: Kebab (kecil, sedang, besar, jumbo, spesial), Burger (ori, cheese, daging, spesial, doble), dan Maryam (ori, susu coklat, keju susu, coklat keju susu).",
            "harga": "Harga kami mulai dari Rp 7.000 hingga Rp 25.000.",
            "pemesanan": "Pemesanan dapat dilakukan melalui WhatsApp atau Website kami.",
            "pre-order": "Untuk pre-order, mohon lakukan minimal H-5 sebelum acara.",
            "pengiriman": "Pengiriman tersedia melalui kurir instan seperti Grab, Gojek, atau Shopee.",
            "bahan": "Kami menggunakan daging premium tanpa pengawet, 100% halal.",
            "promo": "Dapatkan diskon 10% untuk pembelian pertama!",
            "default": "Maaf, saya hanya bisa membantu menjawab seputar layanan dan produk Burger Blenger. Silakan hubungi admin kami untuk hal tersebut."
        };

        // Fungsi untuk menambahkan pesan ke tampilan chat
        function addMessage(sender, message) {
            const messageDiv = document.createElement('div');
            messageDiv.classList.add('message');
            messageDiv.classList.add(sender === 'user' ? 'user-message' : 'bot-message');
            messageDiv.textContent = message;
            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight; // Scroll ke bawah
        }

        // Fungsi untuk memproses pesan dan memberikan respons
        function processMessage(userMessage) {
            const lowerCaseMessage = userMessage.toLowerCase();
            let response = knowledgeBase.default;

            if (lowerCaseMessage.includes("lokasi") || lowerCaseMessage.includes("alamat")) {
                response = knowledgeBase.lokasi;
            } else if (lowerCaseMessage.includes("jam buka") || lowerCaseMessage.includes("buka")) {
                response = knowledgeBase["jam buka"];
            } else if (lowerCaseMessage.includes("menu") || lowerCaseMessage.includes("makanan")) {
                response = knowledgeBase.menu;
            } else if (lowerCaseMessage.includes("harga") || lowerCaseMessage.includes("berapa")) {
                response = knowledgeBase.harga;
            } else if (lowerCaseMessage.includes("pesan") || lowerCaseMessage.includes("order")) {
                response = knowledgeBase.pemesanan;
            } else if (lowerCaseMessage.includes("pre-order")) {
                response = knowledgeBase["pre-order"];
            } else if (lowerCaseMessage.includes("kirim") || lowerCaseMessage.includes("antar")) {
                response = knowledgeBase.pengiriman;
            } else if (lowerCaseMessage.includes("bahan") || lowerCaseMessage.includes("kualitas")) {
                response = knowledgeBase.bahan;
            } else if (lowerCaseMessage.includes("promo") || lowerCaseMessage.includes("diskon")) {
                response = knowledgeBase.promo;
            }

            return response;
        }


        // Fungsi untuk mengirim pesan
        function sendMessage() {
            const userMessage = userInput.value;
            if (!userMessage.trim()) return; // Jangan kirim jika input kosong

            addMessage('user', userMessage);
            userInput.value = ''; // Kosongkan input

            // Simulasikan jeda sebentar sebelum bot menjawab
            setTimeout(() => {
                const botResponse = processMessage(userMessage);
                addMessage('bot', botResponse);
            }, 500); // 0.5 detik
        }

        // Event listener untuk tombol "Enter" pada input
        userInput.addEventListener("keyup", function(event) {
            if (event.key === "Enter") {
                sendMessage();
            }
        });

        // Rekomendasi pesan (contoh)
        const chatMessagesInitial = document.getElementById('chatMessages');

        const initialRecomend = [
          "Lokasi?",
          "Jam buka?",
          "Menu?",
          "Harga?",
          "Cara pesan?",
          "Promo?"
        ];
        
        function addRecomendMessage() {
            const recomendsDiv = document.createElement('div');
            recomendsDiv.classList.add('recomend-messages');
            recomendsDiv.style.display = 'flex';
            recomendsDiv.style.flexWrap = 'wrap';
            recomendsDiv.style.gap = '8px';
            recomendsDiv.style.marginTop = '10px';


            initialRecomend.forEach(recomendText => {
                const recomendButton = document.createElement('button');
                recomendButton.classList.add('recomend-button');
                recomendButton.textContent = recomendText;
                recomendButton.style.padding = '8px 12px';
                recomendButton.style.backgroundColor = '#f0f0f0';
                recomendButton.style.border = '1px solid #ccc';
                recomendButton.style.borderRadius = '4px';
                recomendButton.style.cursor = 'pointer';
                recomendButton.addEventListener('click', () => {
                   userInput.value = recomendText;
                   sendMessage();
                });
                recomendsDiv.appendChild(recomendButton);
                
            });
            chatMessagesInitial.appendChild(recomendsDiv);
        }

        addRecomendMessage();

    </script>
</body>

</html>